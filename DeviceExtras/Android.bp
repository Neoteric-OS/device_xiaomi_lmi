android_app {
    name: "DeviceExtras",
    defaults: [
        "SettingsLibDefaults",
    ],

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
        "//hardware/xiaomi:vendor.xiaomi.hardware.motor-V1.0-java",
        "SettingsLib",
        "VendorSupport-Libs",
    ],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}

prebuilt_etc {
    name: "privapp_whitelist_DeviceExtras",
    sub_dir: "permissions",
    src: "privapp-permissions-DeviceExtras.xml",
    filename_from_src: true,
    system_ext_specific: true,
}
