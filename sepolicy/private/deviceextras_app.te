app_domain(deviceextras_app)

# Allow deviceextras_app to find *_service
allow deviceextras_app {
  app_api_service
  audioserver_service
  cameraserver_service
  drmserver_service
  mediaextractor_service
  mediametrics_service
  mediaserver_service
}:service_manager find;

hal_client_domain(deviceextras_app, hal_motor)

# Allow deviceextras_app read and write /data/data subdirectory
allow deviceextras_app system_app_data_file:dir create_dir_perms;
allow deviceextras_app system_app_data_file:{ file lnk_file } create_file_perms;

# Allow binder communication with gpuservice
binder_call(deviceextras_app, gpuservice)
binder_call(deviceextras_app, hal_motor)

# Allow deviceextras_app to read and write to cgroup/sysfs_leds/sysfs_thermal
allow deviceextras_app sysfs_leds:dir search;
#allow deviceextras_app vendor_sysfs_graphics:dir search;
allow deviceextras_app {
  cgroup
  sysfs_leds
  sysfs_thermal
}:{ file lnk_file } rw_file_perms;
